#!/bin/bash
# Hook: configura LightDM, servizi e branding — AuraOS

set -e

echo "=== [AuraOS] Configurazione servizi ==="

# --- LightDM: config già in includes.chroot/etc/lightdm/ ---
# lightdm.conf imposta autologin=user + user-session=gnome-xorg (X11 per live).
# Il cleanup post-install rimuove autologin e cambia sessione in gnome (Wayland).
# lightdm-gtk-greeter.conf imposta il tema AuraOS per la schermata di login.
# Nessuna configurazione necessaria qui — i file vengono copiati prima degli hook.

# --- Thunderbird: impostazioni predefinite ---
THUNDERBIRD_POLICIES_DIR="/usr/lib/thunderbird/distribution"
mkdir -p "$THUNDERBIRD_POLICIES_DIR"
cat > "$THUNDERBIRD_POLICIES_DIR/policies.json" <<'EOF'
{
  "policies": {
    "DisableTelemetry": true,
    "BlockAboutConfig": false
  }
}
EOF

# --- Sudoers per azioni di sistema ---
echo "user ALL=(ALL) NOPASSWD: /usr/sbin/ufw, /usr/bin/apt-get update, /usr/bin/apt-get upgrade, /usr/bin/calamares, /usr/sbin/update-locale" \
    > /etc/sudoers.d/auraos
chmod 440 /etc/sudoers.d/auraos

# --- rkhunter scan settimanale ---
sed -i 's/CRON_DAILY_RUN=""/CRON_DAILY_RUN="yes"/' /etc/default/rkhunter 2>/dev/null || true

# --- GRUB: branding AuraOS ---
cat > /etc/default/grub <<'EOF'
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="AuraOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash ro"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=1024x768x32,auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_BACKGROUND="/boot/grub/auraos-bg.png"
EOF

# --- Background GRUB 1024x768 (gradiente blu-viola stile macOS) ---
python3 - <<'PYEOF'
import struct, zlib

def make_png(filename, width, height, top_color, bottom_color):
    def lerp(a, b, t): return int(a + (b - a) * t)
    def chunk(tag, data):
        c = struct.pack('>I', len(data)) + tag + data
        return c + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
    rows = b''
    for y in range(height):
        t = y / (height - 1)
        r = lerp(top_color[0], bottom_color[0], t)
        g = lerp(top_color[1], bottom_color[1], t)
        b = lerp(top_color[2], bottom_color[2], t)
        rows += b'\x00' + bytes([r, g, b] * width)
    header = b'\x89PNG\r\n\x1a\n'
    ihdr = chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
    idat = chunk(b'IDAT', zlib.compress(rows, 9))
    iend = chunk(b'IEND', b'')
    with open(filename, 'wb') as f:
        f.write(header + ihdr + idat + iend)

# Gradiente: azzurro cielo → viola notte (stile macOS)
make_png('/boot/grub/auraos-bg.png', 1024, 768, (126, 184, 247), (46, 111, 217))
print('[grub] auraos-bg.png generata')
PYEOF

chmod +x /lib/live/config/9999-auraos-mode 2>/dev/null || true
chmod +x /usr/local/bin/calamares-kiosk.sh 2>/dev/null || true
chmod +x /usr/local/lib/auraos-cleanup.sh 2>/dev/null || true
chmod +x /usr/local/sbin/auraos-check-updates 2>/dev/null || true

# --- Inizializza versions.conf con versione AuraOS corrente ---
# Recupera il tag dell'ultima release da GitHub durante la build.
# Questo evita che i sistemi installati dalla ISO partano con versione vuota
# e riscarichiamo tutti gli script inutilmente al primo auraos-update.
mkdir -p /etc/auraos/profiles
AURAOS_BUILD_VER=$(curl -sf --max-time 15 \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/adri6412/aura-os/releases/latest" \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'])" \
    2>/dev/null || echo "v2.5")
sed -i "s/^AURAOS_VERSION=.*/AURAOS_VERSION=\"${AURAOS_BUILD_VER}\"/" \
    /etc/auraos/versions.conf
echo "[auraos] Versione build impostata: $AURAOS_BUILD_VER"
# File di stato profili (vuoto = solo profili default attivi)
touch /etc/auraos/active-profiles.conf

mkdir -p /etc/systemd/system/multi-user.target.wants/
ln -sf /etc/systemd/system/auraos-firstboot.service \
    /etc/systemd/system/multi-user.target.wants/auraos-firstboot.service \
    2>/dev/null || true

# --- Abilita timer controllo aggiornamenti custom ---
mkdir -p /etc/systemd/system/timers.target.wants/
ln -sf /etc/systemd/system/auraos-update-check.timer \
    /etc/systemd/system/timers.target.wants/auraos-update-check.timer \
    2>/dev/null || true

# --- Flatpak: aggiungi Flathub ---
if command -v flatpak &>/dev/null; then
    flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
    echo "[flatpak] Remote Flathub aggiunto"
fi

# --- Abilita Bluetooth ---
# bluetooth.service (bluetoothd da bluez) non viene abilitato automaticamente.
# Senza questo il controller BT è rilevato ma bluetoothd non parte.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /lib/systemd/system/bluetooth.service \
    /etc/systemd/system/multi-user.target.wants/bluetooth.service 2>/dev/null || true

# --- Abilita LightDM e target grafico ---
# Symlink diretti (systemctl enable non funziona in chroot senza systemd).
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sf /lib/systemd/system/lightdm.service \
    /etc/systemd/system/display-manager.service 2>/dev/null || true
ln -sf /lib/systemd/system/lightdm.service \
    /etc/systemd/system/graphical.target.wants/lightdm.service 2>/dev/null || true
ln -sfn /lib/systemd/system/graphical.target \
    /etc/systemd/system/default.target 2>/dev/null || true

# /etc/X11/default-display-manager: live-config legge questo file
# per sapere quale display manager avviare nella sessione live.
mkdir -p /etc/X11
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager

echo "=== [AuraOS] Servizi configurati OK ==="
