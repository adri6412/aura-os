#!/bin/bash
# Hook: configurazione base sistema AuraOS

set -e

echo "=== [AuraOS] Configurazione sistema ==="

# --- Rendi eseguibili eventuali script custom in /opt ---
find /opt -name "*.py" -exec chmod +x {} \; 2>/dev/null || true
find /opt -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

# --- Profilo dconf utente ---
if command -v dconf &>/dev/null; then
    dconf update 2>/dev/null || true
fi

if [ ! -f /etc/dconf/profile/user ]; then
    mkdir -p /etc/dconf/profile
    cat > /etc/dconf/profile/user <<'PROFILE'
user-db:user
system-db:local
PROFILE
fi
dconf update 2>/dev/null || true

# --- Desktop entries ---
update-desktop-database /usr/share/applications/ 2>/dev/null || true
update-mime-database /usr/share/mime/ 2>/dev/null || true

# --- Desktop files eseguibili ---
chmod +x /etc/skel/Desktop/*.desktop 2>/dev/null || true
chmod +x /usr/local/bin/trust-desktop-files.sh 2>/dev/null || true

# --- ClamAV: aggiornamento DB sempre attivo; scansione settimanale on-demand ---
# clamav-daemon (100-150MB RAM) sostituito da clamav-scan.timer (0 MB idle).
systemctl disable clamav-daemon 2>/dev/null || true
systemctl enable clamav-freshclam 2>/dev/null || true
systemctl enable clamav-scan.timer 2>/dev/null || true

# --- earlyoom: termina proattivamente il processo più pesante quando RAM < 5% ---
# Previene il freeze del sistema per OOM; impatto: ~1MB RAM.
systemctl enable earlyoom 2>/dev/null || true

# --- Tracker: disabilita file indexer a livello sistema ---
# tracker-miner-fs-3 (100-300MB) parte all'avvio per ogni utente.
# --global applica la maschera a tutti gli utenti senza bisogno di login attivo.
systemctl --global mask tracker-miner-fs-3.service \
                          tracker-extract-3.service \
                          tracker-miner-rss-3.service 2>/dev/null || true

ufw default deny incoming
ufw default allow outgoing
ufw --force enable

# Aggiornamento automatico pacchetti: DISABILITATO per overlayfs.
# Con overlayfs, unattended-upgrades scrive i pacchetti aggiornati nell'upper
# layer. Quando poi auraos-update aggiorna gli stessi pacchetti nel lower layer,
# l'upper ha versioni vecchie che fanno shadowing → l'utente vede versioni
# obsolete nonostante l'upgrade nel lower layer.
# Gli aggiornamenti vengono gestiti da auraos-update (aggiorna il lower layer
# + sincronizza il sistema in esecuzione) tramite il timer auraos-update-check.
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::AutocleanInterval "7";
EOF

echo "=== [AuraOS] Configurazione sistema OK ==="
