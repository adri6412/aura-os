#!/bin/bash
# Sessione X11 kiosk per l'installer AuraOS.
# Avviata da GDM tramite /usr/share/xsessions/calamares-kiosk.desktop.
# Nessun GNOME: solo openbox (WM minimal) + Calamares fullscreen.

# Sfondo AuraOS
xsetroot -solid "#1A5CC8" 2>/dev/null || true

# Configura openbox: finestre senza bordi, tutte massimizzate
OBRC="$HOME/.config/openbox/rc-kiosk.xml"
mkdir -p "$HOME/.config/openbox"
cat > "$OBRC" << 'OBEOF'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc"
                xmlns:xi="http://www.w3.org/2001/XInclude">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus><followMouse>no</followMouse></focus>
  <placement><policy>Smart</policy></placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout>MICD</titleLayout>
  </theme>
  <desktops><number>1</number></desktops>
  <applications>
    <application class="*" title="*">
      <fullscreen>yes</fullscreen>
      <decor>no</decor>
      <maximized>yes</maximized>
      <layer>normal</layer>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
OBEOF

# Avvia openbox
openbox --config-file "$OBRC" --sm-disable &
OB_PID=$!

# Attende che openbox sia pronto
sleep 0.3

# Cursore watch durante caricamento Calamares
xsetroot -cursor_name watch 2>/dev/null || true

# Avvia Calamares come root via sudo (sudoers NOPASSWD configurato)
sudo -E calamares

# Calamares uscito: chiude openbox e la sessione
kill "$OB_PID" 2>/dev/null || true
