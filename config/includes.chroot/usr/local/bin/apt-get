#!/bin/bash
# Wrapper apt-get per AuraOS overlayfs.
# Intercetta 'apt-get upgrade/dist-upgrade' e li redirige a auraos-update.
# Tutti gli altri sottocomandi passano direttamente ad apt-get.

REAL_APTGET=/usr/bin/apt-get

ROOT_FSTYPE=$(findmnt -n -o FSTYPE / 2>/dev/null || true)
[[ "$ROOT_FSTYPE" != "overlay" ]] && exec "$REAL_APTGET" "$@"

case "${1:-}" in
    upgrade|dist-upgrade)
        echo "[AuraOS] Aggiornamento in due fasi:"
        echo "  1. Lower layer (sistema base, sopravvive ad auraos-reset)"
        echo "  2. Sistema in esecuzione (pacchetti utente nell'upper layer)"
        echo ""
        # Fase 1: aggiorna il lower layer immutabile
        /usr/local/sbin/auraos-update
        # Fase 2: aggiorna anche il sistema in esecuzione
        echo ""
        echo "[AuraOS] Aggiornamento pacchetti nel sistema in esecuzione..."
        exec "$REAL_APTGET" "$@"
        ;;
    *)
        exec "$REAL_APTGET" "$@"
        ;;
esac
