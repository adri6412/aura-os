#!/bin/bash
# auraos-update — aggiorna il root reale di AuraOS (il lower layer read-only).
# Le modifiche diventano il nuovo lower layer al prossimo riavvio.
# Richiede root.

set -e

[[ $EUID -ne 0 ]] && { echo "Errore: eseguire come root (sudo auraos-update)." >&2; exit 1; }

LOWER="/run/aura-lower"

# Rilevamento overlay via findmnt (non si affida a /run/aura-lower)
ROOT_FSTYPE=$(findmnt -n -o FSTYPE / 2>/dev/null || true)

if [ "$ROOT_FSTYPE" != "overlay" ]; then
    echo "[AuraOS] Overlay non attivo — aggiornamento diretto."
    apt-get update
    apt-get upgrade -y
    exit $?
fi

# Monta il lower layer se non è già accessibile dopo la transizione initramfs→systemd
if [ ! -d "$LOWER/usr" ]; then
    ROOT_DEV=$(blkid -L "AuraOS" 2>/dev/null || true)
    if [ -n "$ROOT_DEV" ]; then
        mkdir -p "$LOWER"
        mount -o ro "$ROOT_DEV" "$LOWER" \
            || { echo "[AuraOS] Errore: impossibile montare $ROOT_DEV." >&2; exit 1; }
    else
        echo "[AuraOS] Errore: partizione root (LABEL=AuraOS) non trovata." >&2
        exit 1
    fi
fi

echo "[AuraOS] ========================================"
echo "[AuraOS]  Aggiornamento sistema AuraOS"
echo "[AuraOS] ========================================"
echo "[AuraOS]  Root reale: $LOWER (read-only → rw temporaneo)"
echo "[AuraOS]  Le modifiche saranno attive al prossimo riavvio."
echo ""

# Sblocca il root reale
echo "[AuraOS] Sblocco root reale..."
mount -o remount,rw "$LOWER"
echo "[AuraOS] Root sbloccato."

cleanup() {
    echo ""
    echo "[AuraOS] Blocco root reale (immutabile)..."
    sync
    mount -o remount,ro "$LOWER" 2>/dev/null || true
    echo "[AuraOS] Root bloccato."
}
trap cleanup EXIT

# Aggiorna il database pacchetti nel chroot del lower
echo "[AuraOS] Aggiornamento database pacchetti..."
chroot "$LOWER" apt-get update -qq

# Mostra i pacchetti che verranno aggiornati
KERNEL_UPGRADES=0
UPGRADABLE=$(chroot "$LOWER" apt-get upgrade --dry-run 2>/dev/null | grep "^Inst" | wc -l)
if [ "$UPGRADABLE" -eq 0 ]; then
    echo "[AuraOS] Nessun pacchetto Debian da aggiornare."
else
    echo "[AuraOS] $UPGRADABLE pacchett$([ "$UPGRADABLE" -eq 1 ] && echo 'o' || echo 'i') da aggiornare."

    # Rileva in anticipo se verrà aggiornato un kernel
    KERNEL_UPGRADES=$(chroot "$LOWER" apt-get upgrade --dry-run 2>/dev/null | grep "^Inst linux-image" | wc -l)

    chroot "$LOWER" apt-get upgrade -y

    echo ""
    echo "[AuraOS] ========================================"
    echo "[AuraOS]  Pacchetti Debian aggiornati."
    echo "[AuraOS] ========================================"
fi

# Se un kernel è stato aggiornato, rigenera grub.cfg nel lower layer.
# Con overlayfs update-grub deve girare nel chroot del lower layer (con i
# bind mount di /proc /sys /dev), altrimenti scrive sull'upper layer e
# GRUB non vede il nuovo kernel al riavvio.
if [ "$KERNEL_UPGRADES" -gt 0 ]; then
    echo ""
    echo "[AuraOS] Kernel aggiornato — rigenero GRUB nel lower layer..."
    GRUB_BINDS=()
    for fs in proc sys dev dev/pts run; do
        mkdir -p "$LOWER/$fs"
        mount --bind "/$fs" "$LOWER/$fs" 2>/dev/null && GRUB_BINDS+=("$LOWER/$fs") || true
    done
    chroot "$LOWER" update-grub 2>/dev/null \
        || echo "[AuraOS] WARN: update-grub fallito — eseguire manualmente: sudo auraos-change-kernel update-grub"
    for mp in "${GRUB_BINDS[@]:-}"; do
        umount "$mp" 2>/dev/null || true
    done
    echo "[AuraOS] GRUB aggiornato."
fi

# ── Migrazioni pacchetti ─────────────────────────────────────────────────────
# Ogni voce è una migrazione one-shot: viene eseguita una volta e poi
# marcata come completata in /etc/auraos/migrations.done nel lower layer.
apply_package_migrations() {
    local LOWER="$1"
    local DONE_FILE="$LOWER/etc/auraos/migrations.done"
    touch "$DONE_FILE" 2>/dev/null || true

    run_migration() {
        local id="$1"; shift
        grep -qx "$id" "$DONE_FILE" 2>/dev/null && return 0
        echo "[AuraOS] Migrazione: $id"
        "$@" && echo "$id" >> "$DONE_FILE" \
            || echo "[AuraOS] WARN: migrazione $id fallita (skip)"
    }

    # ── v1.5 ─────────────────────────────────────────────────────────────────
    # Abilita bluetooth.service se non abilitato
    run_migration "v1.5-enable-bluetooth" \
        bash -c "chroot '$LOWER' systemctl enable bluetooth 2>/dev/null || true"

    # ── v1.7 ─────────────────────────────────────────────────────────────────
    # Crea /etc/bluetooth/main.conf con AutoEnable=true se non esiste
    run_migration "v1.7-bluetooth-autoenable" \
        bash -c "
            mkdir -p '$LOWER/etc/bluetooth'
            if ! grep -q 'AutoEnable' '$LOWER/etc/bluetooth/main.conf' 2>/dev/null; then
                printf '[General]\nAutoEnable = true\nFastConnectable = true\n\n[Policy]\nAutoEnable = true\n' \
                    > '$LOWER/etc/bluetooth/main.conf'
            fi"

    # ── v1.9 ─────────────────────────────────────────────────────────────────
    # Rimuovi USBGuard (bloccava BT e USB senza GUI di gestione)
    run_migration "v1.9-remove-usbguard" \
        bash -c "chroot '$LOWER' dpkg -l usbguard 2>/dev/null | grep -q '^ii' \
            && chroot '$LOWER' apt-get remove --purge -y usbguard \
            || true"

    # Installa rfkill e bluez se mancanti
    run_migration "v1.9-install-bluetooth-tools" \
        bash -c "chroot '$LOWER' apt-get install -y rfkill bluez 2>/dev/null || true"

    # ── future ───────────────────────────────────────────────────────────────
    # Aggiungere nuove migrazioni qui. Il formato è:
    #   run_migration "vX.Y-descrizione-breve" bash -c "..."
    # Ogni migrazione viene eseguita una sola volta su qualsiasi sistema,
    # indipendentemente dalla versione di partenza.
}

# ── Aggiornamento componenti custom ──────────────────────────────────────────
update_custom_components() {
    local LOWER="$1"
    local VERSIONS_FILE="$LOWER/etc/auraos/versions.conf"

    echo ""
    echo "[AuraOS] Controllo aggiornamenti componenti custom..."

    # Leggi versioni installate
    local inst_agh="" inst_auraos=""
    if [[ -f "$VERSIONS_FILE" ]]; then
        while IFS='=' read -r k v; do
            v="${v//\"/}"
            case "$k" in
                ADGUARDHOME_VERSION) inst_agh="$v" ;;
                AURAOS_VERSION)      inst_auraos="$v" ;;
            esac
        done < "$VERSIONS_FILE"
    fi

    # Funzione fetch versione da GitHub
    gh_latest() {
        curl -sf --max-time 10 \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/${1}/releases/latest" \
            | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'])" \
            2>/dev/null || echo ""
    }

    local latest_agh latest_auraos
    latest_agh=$(gh_latest "AdguardTeam/AdGuardHome")
    latest_auraos=$(gh_latest "adri6412/aura-os")

    echo "[AuraOS]  Installato:  auraos=${inst_auraos:-<non impostato>}  agh=${inst_agh:-<non impostato>}"
    echo "[AuraOS]  Disponibile: auraos=${latest_auraos:-<non raggiungibile>}  agh=${latest_agh:-<non raggiungibile>}"

    local updated=false

    # ── AdGuardHome ───────────────────────────────────────────────────────────
    if [[ -n "$latest_agh" && ( -z "$inst_agh" || "$latest_agh" != "$inst_agh" ) ]]; then
        echo "[AuraOS] AdGuardHome: $inst_agh → $latest_agh"
        local ver="${latest_agh#v}"
        local url="https://github.com/AdguardTeam/AdGuardHome/releases/download/${latest_agh}/AdGuardHome_linux_amd64.tar.gz"
        if curl -fsSL --max-time 120 "$url" -o /tmp/agh-update.tar.gz 2>/dev/null; then
            systemctl stop AdGuardHome 2>/dev/null || true
            tar -xzf /tmp/agh-update.tar.gz -C /tmp/
            install -m 0755 /tmp/AdGuardHome/AdGuardHome "$LOWER/opt/AdGuardHome/AdGuardHome"
            rm -rf /tmp/AdGuardHome /tmp/agh-update.tar.gz
            sed -i "s/^ADGUARDHOME_VERSION=.*/ADGUARDHOME_VERSION=\"${latest_agh}\"/" "$VERSIONS_FILE"
            systemctl start AdGuardHome 2>/dev/null || true
            echo "[AuraOS] AdGuardHome aggiornato a $latest_agh."
            updated=true
        else
            echo "[AuraOS] WARN: impossibile scaricare AdGuardHome $latest_agh, skip."
        fi
    elif [[ -n "$inst_agh" ]]; then
        echo "[AuraOS] AdGuardHome $inst_agh: aggiornato."
    fi

    # ── Script auraos-* ───────────────────────────────────────────────────────
    if [[ -n "$latest_auraos" && ( -z "$inst_auraos" || "$latest_auraos" != "$inst_auraos" ) ]]; then
        echo "[AuraOS] AuraOS scripts: ${inst_auraos:-non installato} → $latest_auraos"
        local base_url="https://raw.githubusercontent.com/adri6412/aura-os/${latest_auraos}/config/includes.chroot/usr/local/sbin"
        local ok=true
        for script in auraos-update auraos-unlock auraos-lock auraos-status auraos-reset auraos-check-updates auraos-switch auraos-change-kernel; do
            if curl -fsSL --max-time 30 "${base_url}/${script}" \
                    -o "$LOWER/usr/local/sbin/${script}.new" 2>/dev/null; then
                mv "$LOWER/usr/local/sbin/${script}.new" "$LOWER/usr/local/sbin/${script}"
                chmod +x "$LOWER/usr/local/sbin/${script}"
                ln -sf "/usr/local/sbin/${script}" "$LOWER/usr/local/bin/${script}" 2>/dev/null || true
                # Copia anche nel path in esecuzione: se l'upper layer ha una copia
                # vecchia shadowing il lower layer, senza questa riga il nuovo script
                # non viene usato finché non si riavvia.
                cp "$LOWER/usr/local/sbin/${script}" "/usr/local/sbin/${script}" 2>/dev/null || true
                chmod +x "/usr/local/sbin/${script}" 2>/dev/null || true
            else
                echo "[AuraOS] WARN: impossibile scaricare $script, skip."
                rm -f "$LOWER/usr/local/sbin/${script}.new"
                ok=false
            fi
        done
        # Aggiorna anche i profili
        local profiles_url="https://raw.githubusercontent.com/adri6412/aura-os/${latest_auraos}/config/includes.chroot/etc/auraos/profiles"
        local profiles_index
        profiles_index=$(curl -sf --max-time 10 \
            "https://api.github.com/repos/adri6412/aura-os/contents/config/includes.chroot/etc/auraos/profiles?ref=${latest_auraos}" \
            | python3 -c "import sys,json; [print(f['name']) for f in json.load(sys.stdin) if f['name'].endswith('.profile')]" \
            2>/dev/null || echo "")
        if [[ -n "$profiles_index" ]]; then
            mkdir -p "$LOWER/etc/auraos/profiles"
            while IFS= read -r pfile; do
                curl -fsSL --max-time 30 "${profiles_url}/${pfile}" \
                    -o "$LOWER/etc/auraos/profiles/${pfile}.new" 2>/dev/null \
                    && mv "$LOWER/etc/auraos/profiles/${pfile}.new" \
                          "$LOWER/etc/auraos/profiles/${pfile}" \
                    || rm -f "$LOWER/etc/auraos/profiles/${pfile}.new"
            done <<< "$profiles_index"
            echo "[AuraOS] Profili aggiornati."
        fi
        # Aggiorna anche il manager (file Python — contiene le tab UI)
        local manager_url="https://raw.githubusercontent.com/adri6412/aura-os/${latest_auraos}/config/includes.chroot/opt/auraos-manager/auraos_manager.py"
        if curl -fsSL --max-time 30 "$manager_url" \
                -o "$LOWER/opt/auraos-manager/auraos_manager.py.new" 2>/dev/null; then
            mv "$LOWER/opt/auraos-manager/auraos_manager.py.new" \
               "$LOWER/opt/auraos-manager/auraos_manager.py"
            chmod +x "$LOWER/opt/auraos-manager/auraos_manager.py"
            cp "$LOWER/opt/auraos-manager/auraos_manager.py" \
               "/opt/auraos-manager/auraos_manager.py" 2>/dev/null || true
            echo "[AuraOS] Manager UI aggiornato."
        else
            rm -f "$LOWER/opt/auraos-manager/auraos_manager.py.new"
            echo "[AuraOS] WARN: impossibile aggiornare il manager, skip."
        fi

        if $ok; then
            sed -i "s/^AURAOS_VERSION=.*/AURAOS_VERSION=\"${latest_auraos}\"/" "$VERSIONS_FILE"
            echo "[AuraOS] Script auraos-* aggiornati a $latest_auraos."
            updated=true
        fi
    elif [[ -n "$inst_auraos" ]]; then
        echo "[AuraOS] AuraOS scripts $inst_auraos: aggiornati."
    fi

    $updated || echo "[AuraOS] Nessun aggiornamento custom disponibile."
}

# Esegui migrazioni pacchetti (one-shot, tracciate in migrations.done)
apply_package_migrations "$LOWER"

# Esegui aggiornamento custom sul lower layer (già sbloccato dal trap)
update_custom_components "$LOWER"

echo ""
echo "[AuraOS] ========================================"
echo "[AuraOS]  Aggiornamento completato."
echo "[AuraOS]  Riavvia per applicare le modifiche."
echo "[AuraOS] ========================================"
