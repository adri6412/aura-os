#!/bin/sh
# Live-config hook: configura la sessione kiosk installer per l'utente live.
# Gira durante il boot live, dopo che live-config ha creato l'utente.

# Aspetta che live-config abbia creato l'utente live
i=0
while [ $i -lt 30 ]; do
    id user >/dev/null 2>&1 && break
    sleep 1
    i=$((i + 1))
done

# Configura AccountsService: GDM usa 'calamares-kiosk' come sessione X11
# per l'utente live all'auto-login.
mkdir -p /var/lib/AccountsService/users/
cat > /var/lib/AccountsService/users/user << 'EOF'
[User]
XSession=calamares-kiosk
SystemAccount=false
EOF
