#!/bin/sh
# auto/config — lb config wrapper for AuraOS

set -e

lb config noauto \
    --distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-binary-security "http://security.debian.org/debian-security/" \
    --security true \
    --updates true \
    --backports false \
    --architectures amd64 \
    --linux-packages "linux-image linux-headers" \
    --linux-flavours amd64 \
    --bootappend-live "boot=live components quiet splash locales=it_IT.UTF-8 keyboard-layouts=it timezone=Europe/Rome hostname=auraos username=user" \
    --bootappend-install "locales=it_IT.UTF-8 keyboard-layouts=it timezone=Europe/Rome" \
    --debian-installer live \
    --debian-installer-gui true \
    --debian-installer-distribution trixie \
    --iso-application "AuraOS" \
    --iso-preparer "AuraOS Project" \
    --iso-publisher "AuraOS Project" \
    --iso-volume "AuraOS-1.0" \
    --memtest none \
    --win32-loader false \
    --image-name "auraos-1.0-amd64" \
    "${@}"
